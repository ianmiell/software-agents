#!/usr/bin/env bash
# Run all of a team's agents continuously, each in its own loop.
#
# Usage: bin/run-team <team>
#   tmux new -s agents-<team> '~/git/software-agents/bin/run-team <team>'
#
# Each agent backs off on its own: after a run that did work it sleeps
# MIN_SLEEP; after a run that was idle (output matched IDLE_PATTERNS) or
# failed, it sleeps twice as long as last time, up to MAX_SLEEP. Agents in
# FIXED_SLEEP_AGENTS always sleep MAX_SLEEP. All from teams/<team>/team.sh.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ "$#" -ne 1 ]; then
  echo "Usage: $0 <team>" >&2
  exit 1
fi
team="$1"
team_dir="$ROOT/teams/$team"

if [ ! -f "$team_dir/team.sh" ]; then
  echo "No team '$team' (missing $team_dir/team.sh)" >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$team_dir/team.sh"
FIXED_SLEEP_AGENTS=("${FIXED_SLEEP_AGENTS[@]+"${FIXED_SLEEP_AGENTS[@]}"}")
mkdir -p "$LOG_DIR"

fixed_sleep() {
  local a
  for a in "${FIXED_SLEEP_AGENTS[@]+"${FIXED_SLEEP_AGENTS[@]}"}"; do
    [ "$a" = "$1" ] && return 0
  done
  return 1
}

agent_loop() {
  local agent="$1"
  local log="$LOG_DIR/agent-$agent.log"
  local output status pause=0
  while true; do
    # run-agent appends to the log itself; capture the output to judge idleness.
    output="$("$ROOT/bin/run-agent" "$team" "$agent" 2>&1)"
    status=$?
    echo "$output"
    if fixed_sleep "$agent"; then
      pause="$MAX_SLEEP"
    elif [ "$status" -ne 0 ] || grep -qiE "$IDLE_PATTERNS" <<<"$output"; then
      pause=$(( pause * 2 ))
      [ "$pause" -lt "$MIN_SLEEP" ] && pause="$MIN_SLEEP"
      [ "$pause" -gt "$MAX_SLEEP" ] && pause="$MAX_SLEEP"
    else
      pause="$MIN_SLEEP"
    fi
    echo "$(date -u): [$agent] sleeping ${pause}s" | tee -a "$log"
    sleep "$pause"
  done
}

echo "$(date -u): starting $team team: ${AGENTS[*]}"
echo "  work dir:   $WORK_DIR"
echo "  sleep:      ${MIN_SLEEP}s after work, doubling when idle up to ${MAX_SLEEP}s"
echo "  logs:       $LOG_DIR/agent-*.log"
echo "  stop:       ctrl-c (or kill $$)"

pids=()
for agent in "${AGENTS[@]}"; do
  agent_loop "$agent" &
  pids+=("$!")
  echo "  $agent: pid $!"
done

trap 'echo "Stopping $team team..."; kill "${pids[@]}" 2>/dev/null; pkill -P $$ 2>/dev/null; exit 0' INT TERM
wait
