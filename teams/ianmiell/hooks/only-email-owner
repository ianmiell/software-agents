#!/usr/bin/env python3
"""PreToolUse hook: the agents may only send new emails to NOTIFY_TO.

The agents read issue text written by strangers, so the instruction to only
email the owner is backed by this check. It blocks every Gmail tool except
send_message, and a send_message with any recipient other than NOTIFY_TO
(from team.sh), any cc or bcc, or a draftId (which sends a draft as is).
Exit 2 blocks the call and shows the reason to the agent.
"""
import json
import re
import sys
from pathlib import Path

TEAM_SH = Path(__file__).resolve().parent.parent / "team.sh"


def block(reason):
    print(f"Blocked: {reason}", file=sys.stderr)
    sys.exit(2)


def main():
    call = json.load(sys.stdin)
    tool = call.get("tool_name", "")
    args = call.get("tool_input") or {}

    match = re.search(r"^NOTIFY_TO=(\S+)", TEAM_SH.read_text(), re.MULTILINE)
    if not match:
        block(f"no NOTIFY_TO in {TEAM_SH}")
    owner = match.group(1).strip("'\"").lower()

    if tool != "mcp__claude_ai_Gmail__send_message":
        block(f"agents may only send email, not use {tool}")
    if args.get("draftId"):
        block("sending drafts is not allowed")
    if args.get("cc") or args.get("bcc"):
        block("cc and bcc are not allowed")
    to = args.get("to") or []
    if isinstance(to, str):
        to = [to]
    if not to or any(addr.strip().lower() != owner for addr in to):
        block(f"email may only be sent to {owner}, not {to}")
    sys.exit(0)


if __name__ == "__main__":
    main()
