#!/usr/bin/env bash
# Which of ianmiell's GitHub repos the ianmiell team watches, and how.
#
# Usage:
#   repos list             every watched repo and its mode: "<repo> <main|pr>"
#   repos mode <repo>...   each repo's mode: "<repo> <ignore|main|pr>"
#   repos labels <repo>    create the team's labels on a watched repo
#
# Watched means owned by ianmiell, not a fork, not archived and not in
# ignore-repos.txt. Repos in pr-repos.txt are changed through PRs, the rest
# directly on their default branch. ignore-repos.txt wins over pr-repos.txt.
# Repos may be given as <repo> or ianmiell/<repo>.
set -euo pipefail

OWNER=ianmiell
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

LABELS=(
  "agent-task|0075ca|Task for the engineer agent"
  "agent-task-high|e11d48|High-priority engineer task"
  "triaged|c5def5|Triaged by the triage agent"
  "code-concern|f9d0c4|Raised by code-reviewer"
  "critical|b60205|Requires immediate attention"
  "needs-human-review|0e8a16|Needs a human decision, approval or deploy"
)

# Repo names in a list file, without comments, blank lines or the owner.
read_list() {
  sed -e 's/#.*//' -e 's/[[:space:]]//g' -e "s|^$OWNER/||I" "$1" | grep -v '^$' || true
}

# GitHub repo names are case-insensitive.
in_list() {
  grep -qixF -- "$1" <<<"$2"
}

owned=""
ignore=""
pr=""
load() {
  owned="$(gh repo list "$OWNER" --source --no-archived --limit 5000 --json name --jq '.[].name')"
  ignore="$(read_list "$DIR/ignore-repos.txt")"
  pr="$(read_list "$DIR/pr-repos.txt")"
}

mode_of() {
  local repo="$1"
  if ! in_list "$repo" "$owned" || in_list "$repo" "$ignore"; then
    echo ignore
  elif in_list "$repo" "$pr"; then
    echo pr
  else
    echo main
  fi
}

usage() {
  sed -n '3,6p' "${BASH_SOURCE[0]}" | sed 's/^# //' >&2
  exit 1
}

[ "$#" -ge 1 ] || usage
cmd="$1"
shift
case "$cmd" in
  list)
    load
    while read -r repo; do
      mode="$(mode_of "$repo")"
      [ "$mode" = ignore ] || echo "$repo $mode"
    done <<<"$owned"
    ;;
  mode)
    [ "$#" -ge 1 ] || usage
    load
    for repo in "$@"; do
      repo="${repo#"$OWNER"/}"
      echo "$repo $(mode_of "$repo")"
    done
    ;;
  labels)
    [ "$#" -eq 1 ] || usage
    load
    repo="${1#"$OWNER"/}"
    if [ "$(mode_of "$repo")" = ignore ]; then
      echo "$repo is ignored; not creating labels" >&2
      exit 1
    fi
    for label in "${LABELS[@]}"; do
      IFS='|' read -r name color desc <<<"$label"
      gh label create "$name" --color "$color" --description "$desc" -R "$OWNER/$repo" >/dev/null 2>&1 || true
    done
    ;;
  *)
    usage
    ;;
esac
